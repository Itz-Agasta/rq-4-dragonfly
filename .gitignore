# rust
/target/
**/*.rs.bk

# node
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# python (training only)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# generated data
# models/ is committed on purpose: the .onnx artifacts are small and are part
# of the runtime. Datasets and mission recordings are not.
data/*
!data/README.md
*.parquet
*.h5
*.bin
*.ulg

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# deployment
# `.env` holds the domain, the ACME contact and the image tag: everything that
# differs between one deployment and the next. Keeping it out is what lets the
# server run `git pull` without ever hitting a conflict.
deploy/.env
# The curated mission REPLAY opens, scp'd onto the box once. Also caught by the
# *.parquet rule above, listed here so the directory's purpose is obvious.
deploy/missions/
