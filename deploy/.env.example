# Copy to `.env` beside this file and fill in. `.env` is gitignored: it is the
# one place a deployment differs from what is committed, which is what keeps
# `git pull` on the server conflict free.

# Docker Hub account the image is pushed to and pulled from.
DOCKER_USER=agasta

# Image tag. Version it rather than riding `latest`, so a rollback is a one line
# edit here plus `docker compose up -d` instead of a rebuild of whatever main
# happens to be that day.
TAG=0.1.0

# Public name Caddy serves and gets a certificate for.
DRAGONFLY_DOMAIN=dragonfly.vyse.site

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=you@example.com
