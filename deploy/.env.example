# Docker Hub account the image is pushed to and pulled from.
DOCKER_USER=agasta

# Image tag
TAG=0.1.0

# Public name of the scroll site. Caddy gets a certificate for it.
DRAGONFLY_DOMAIN=dragonfly.vyse.site

# Public name of the ground station. Its own A record, DNS only.
GCS_DOMAIN=gcs.dragonfly.vyse.site

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=you@example.com
