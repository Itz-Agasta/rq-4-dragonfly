# Nothing in this file is specific to one deployment, on purpose.
#
# The domain and the ACME contact come from the environment, so this file is
# committed and never edited on a server.
#
# Both are set in `deploy/.env`, which is gitignored.
{
	# Where Let's Encrypt sends expiry notices. Unreachable is accepted by ACME
	# but you lose the warning, so it is required here rather than defaulted.
	email {$ACME_EMAIL}
}

{$DRAGONFLY_DOMAIN} {
	encode zstd gzip

	# /ops went out on a demo slide while this name was still the ground station.
	# It lands on the site now, whose button opens the GCS. 302, not 301: a
	# browser caches a 301 forever, and this redirect is meant to be removable.
	redir /ops* / 302

	# Vite fingerprints everything under /assets, so a changed file is a new URL.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# The scroll site, rsync'd from site/dist into deploy/site.
	root * /srv/site
	file_server
}

{$GCS_DOMAIN} {
	# A replay window is up to MAX_FRAMES (20,000) frames of MessagePack, which
	# compresses well and is the largest thing the core ever serves. The
	# WebSocket feed is per-message binary and passes through untouched.
	encode zstd gzip

	# Caddy proxies WebSocket upgrades natively; /ws needs no separate handler.
	reverse_proxy core:8787
}
